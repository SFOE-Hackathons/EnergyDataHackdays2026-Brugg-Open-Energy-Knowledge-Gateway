# ============================================================
# SFOE Open Energy Knowledge Agent - Example Environment File
# ============================================================
#
# BASIC SETUP
# ------------------------------------------------------------
# 1. Copy this file and rename the copy to:
#
#       .env
#
# 2. Fill in your own AWS credentials and, if required,
#    your Cognito client credentials.
#
# 3. Keep .env private.
#    NEVER commit .env to GitHub.
#
# 4. The .env.example file itself is safe to commit because
#    it contains only placeholders and public configuration.
#
# Windows:
#       copy .env.example .env
#
# Then edit .env and replace the placeholder values.
# ============================================================


# ============================================================
# SFOE / COGNITO AUTHENTICATION
# ============================================================

TOKEN_URL="https://my-domain-ajdb98m7.auth.eu-central-1.amazoncognito.com/oauth2/token"

# If your setup requires Cognito client credentials,
# uncomment these lines and insert your own values.
# CLIENT_ID="YOUR_COGNITO_CLIENT_ID"
# CLIENT_SECRET="YOUR_COGNITO_CLIENT_SECRET"


# ============================================================
# SFOE MCP GATEWAY
# ============================================================

GATEWAY_URL="https://bfe-energy-knowledge-open-v6rj5uttek.gateway.bedrock-agentcore.eu-central-1.amazonaws.com/mcp"


# ============================================================
# AWS / AMAZON BEDROCK
# ============================================================

AWS_REGION="eu-central-1"

# Use your OWN AWS credentials.
# Never commit real credentials to GitHub.
AWS_ACCESS_KEY_ID="YOUR_AWS_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY="YOUR_AWS_SECRET_ACCESS_KEY"


# ============================================================
# PRODUCTION MODEL
# ============================================================

BEDROCK_MODEL_ID="nvidia.nemotron-super-3-120b"


# ============================================================
# RAG / AGENT SETTINGS
# ============================================================

TOP_K_RESULTS=5


# ============================================================
# BENCHMARK / EVALUATION SETTINGS
# ============================================================
# These values are only needed when running benchmark scripts.

NUM_FINALISTS=3

JUDGE_MODEL_ID="qwen.qwen3-235b-a22b-2507-v1:0"

MAX_JUDGE_TOKENS=3000
