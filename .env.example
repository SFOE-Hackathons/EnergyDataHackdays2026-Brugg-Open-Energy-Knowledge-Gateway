# Copy to .env and fill in. .env is gitignored — never commit real values.
#
#   cp .env.example .env
#
# To use these with the AWS CLI / boto3, export them into your shell:
#
#   set -a; source .env; set +a
#
# (A .env file is NOT read automatically by the aws CLI or boto3 — only by
# python-dotenv, which mcp-gateway/dev_run.py uses. The `set -a` above is what
# makes the same file work for both.)


# ---------------------------------------------------------------------------
# AWS — this is what the MCP server actually runs on
# ---------------------------------------------------------------------------
# mcp-gateway/ calls `bedrock-agent-runtime:Retrieve` directly under the
# ambient AWS identity: an execution role on Lambda, these credentials (or
# AWS_PROFILE) when run locally. The role or user needs `bedrock:Retrieve` on
# the knowledge base ARN and nothing else.
#
# The server holds no secrets of its own. It used to exchange the Cognito
# credentials below for a bearer token and call the gateway; it no longer does,
# because the gateway now sits in front of it rather than behind it.
#
# Console: https://542202863496.signin.aws.amazon.com/console
AWS_REGION=eu-central-1
AWS_DEFAULT_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ONLY for temporary credentials (key id starts with ASIA), e.g. from SSO or
# an assumed role. Leave this line commented out for permanent IAM user keys
# (key id starts with AKIA).
#
# Do not set it to an empty value. botocore treats an empty AWS_SESSION_TOKEN
# as a real token and sends it, and AWS rejects the request with
# "ExpiredTokenException" even though the key and secret are perfectly valid.
# That failure names the wrong cause and costs an hour to find.
#
# AWS_SESSION_TOKEN=

# Alternative to the three keys above: configure a named profile once with
# `aws configure --profile bfe` and set only this. If AWS_PROFILE is set, leave
# the key/secret lines empty — setting both is ambiguous and the keys win.
# AWS_PROFILE=bfe


# ---------------------------------------------------------------------------
# Cognito client_credentials — for CLIENTS of the gateway, not for the server
# ---------------------------------------------------------------------------
# The AgentCore Gateway authorizes inbound requests with a JWT from the Cognito
# pool named in infra/create-gateway.sh. Anyone calling the gateway — the
# reference scripts at the repo root (query_gateway.py, list_tools.py,
# test_gateway.py), an MCP client, an agent — needs these. The MCP server
# itself does not, and no longer reads them.
#
# More than one pool exists in this account and their credentials are NOT
# interchangeable. A token minted by the wrong pool is issued happily and then
# rejected by the gateway with 403, so a 200 from the token endpoint proves
# nothing about whether this pair matches the gateway.
#
# !!! Never commit these to GitHub !!!
CLIENT_ID=
CLIENT_SECRET=

# Where to exchange the client credentials for a token: the Cognito *hosted
# domain*, not the OIDC discovery URL the gateway is configured with.
TOKEN_URL=https://vl-bfe-kg-bfe-542202863496.auth.eu-central-1.amazoncognito.com/oauth2/token

# The AgentCore Gateway MCP endpoint — the public entry point. This is the URL
# to hand out. Read the live value back with `./infra/create-gateway.sh --show`.
GATEWAY_URL=https://bfe-energy-knowledge-gateway-knpw2atkay.gateway.bedrock-agentcore.eu-central-1.amazonaws.com/mcp


# ---------------------------------------------------------------------------
# AWS resource identifiers
# ---------------------------------------------------------------------------
# All in eu-central-1. Read back at any time with:
#
#   ./infra/create-gateway.sh --show
#
# The knowledge base is a MANAGED Bedrock knowledge base, so its embedding
# model, vector store and chunking are service-operated and not configurable —
# and retrieval is configured through `managedSearchConfiguration`, since
# `vectorSearchConfiguration` is rejected for managed knowledge bases.
# Optional; defaults to this value in mcp-gateway/config.py.
KNOWLEDGE_BASE_ID=ZPVWAEHXNB

# The gateway and its target, both created by infra/create-gateway.sh. The
# target is the MCP server itself, reached over its Lambda Function URL.
GATEWAY_ID=bfe-energy-knowledge-gateway-knpw2atkay
GATEWAY_TARGET_ID=

# The target's NAME, which the gateway prefixes onto every tool it exports:
# `search_energy_knowledge` is called as `bfe-energy___search_energy_knowledge`.
# The scripts at the repo root add this prefix for you. Only set it if the
# TARGET_NAME in infra/create-gateway.sh was changed; the default matches.
# GATEWAY_TARGET_NAME=bfe-energy
